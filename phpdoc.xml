<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns="https://www.phpdoc.org">
    <title>ClearView Neo</title>
    <paths>
        <output>phpdoc</output>
    </paths>
    <version number="1.0.0">
        <api format="php">
            <source dsn=".">
                <path>.</path>
            </source>
            <ignore hidden="true" symlinks="true">
                <path>vendor/**/*</path>
                <path>docs/**/*</path>
                <path>phpdoc/**/*</path>
                <path>Test/**/*</path>
                <path>tests/**/*</path>
                <path>hallucinated-branches/**/*</path>
            </ignore>
        </api>
    </version>
</phpdocumentor>
