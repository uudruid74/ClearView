<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://www.phpdoc.org"
>
    <title>ClearView API</title>
    <paths>
        <output>docs/phpdoc</output>
        <cache>docs/phpdoc/.cache</cache>
    </paths>
    <version number="1.0.0">
        <api>
            <source dsn=".">
                <paths>
                    <path>./</path>
                </paths>
            </source>
            <ignore>
                <path>vendor/**/*</path>
                <path>tests/**/*</path>
                <path>docs/**/*</path>
            </ignore>
            <extensions>
                <extension>php</extension>
                <extension>inc</extension>
            </extensions>
            <visibility>public</visibility>
            <include-source>false</include-source>
            <default-package-name>ClearView</default-package-name>
        </api>
    </version>
    <template name="docs/phpdoc-templates/no-inherit"/>
</phpdocumentor>
